# Salin ke .env di server:  cp .env.docker.example .env
# Wajib diganti: APP_URL, APP_DOMAIN (bila pakai Caddy), APP_KEY, DB_PASSWORD, DB_ROOT_PASSWORD,
# BOOTSTRAP_SUPER_ADMIN_PASSWORD.

APP_NAME="OneClick Control Center"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://control.contoh.co.id

# Pintu depan (pilih salah satu):
#  - Port 80/443 server kosong  -> COMPOSE_PROFILES=caddy + isi APP_DOMAIN (HTTPS otomatis oleh container Caddy).
#      DNS A record domain harus sudah mengarah ke IP server.
#  - Port 80/443 sudah dipakai proyek lain (mis. OneClick) -> kosongkan COMPOSE_PROFILES & APP_DOMAIN;
#      arahkan reverse proxy yang ada ke http://127.0.0.1:APP_FORWARD_PORT.
COMPOSE_PROFILES=
APP_DOMAIN=
APP_FORWARD_PORT=8081

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# Database MySQL di container "mysql" (docker-compose.yml). DB_HOST jangan diubah.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=oneclick_control_center
DB_USERNAME=control_center
DB_PASSWORD=ganti-password-kuat
DB_ROOT_PASSWORD=ganti-password-root-kuat
DB_FORWARD_PORT=3308

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true bila diakses lewat HTTPS.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Password akun Super Admin pertama (username: novtandhip), dipakai oleh SuperAdminSeeder saat:
#   docker compose exec app php artisan db:seed --force
# Kosong = dibuat password acak dan ditampilkan SEKALI di layar. Ganti setelah login pertama.
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
